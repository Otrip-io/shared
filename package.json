{
  "name": "@otrip/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc"
  },
  "exports": {
    ".":            { "types": "./dist/index.d.ts",            "default": "./dist/index.js" },
    "./constants":  { "types": "./dist/constants/index.d.ts",  "default": "./dist/constants/index.js" },
    "./date":       { "types": "./dist/date/index.d.ts",       "default": "./dist/date/index.js" },
    "./errors":     { "types": "./dist/errors/index.d.ts",     "default": "./dist/errors/index.js" },
    "./messages":   { "types": "./dist/messages/index.d.ts",   "default": "./dist/messages/index.js" },
    "./validation": { "types": "./dist/validation/index.d.ts", "default": "./dist/validation/index.js" }
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
